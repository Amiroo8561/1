{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ac7e4fec-bd28-42f6-b9bb-c50b37214db9","database_name": "1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f4d39db519584859bee1a9ebca7559ce" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
